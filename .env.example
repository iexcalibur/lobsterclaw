# =============================================================
# PyGate — Personal AI Assistant
# Copy this file to .env and fill in your values
# =============================================================

# =============================================================
# LLM Provider
# =============================================================
LLM_PROVIDER=anthropic               # anthropic | openai
ANTHROPIC_API_KEY=                   # Required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                      # Required if LLM_PROVIDER=openai
LLM_MODEL=claude-opus-4-5            # or gpt-4o, claude-3-5-sonnet-20241022, etc.
LLM_MAX_TOKENS=8096

# =============================================================
# Telegram
# =============================================================
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_OWNER_ID=                   # Your numeric Telegram user ID (from @userinfobot)

# =============================================================
# Tool Policy
# Controls exactly which tools the AI can use.
# TOOLS_ALLOW  — whitelist (only these run)
# TOOLS_DENY   — blacklist (these are always blocked)
# TOOLS_REQUIRE_CONFIRMATION — AI must ask YOU before running these
# =============================================================
TOOLS_ALLOW=web_fetch,web_search,cron,memory_search,memory_get,memory_write,message,tts,pdf,image
TOOLS_DENY=exec,process,browser,write,edit,apply_patch
TOOLS_REQUIRE_CONFIRMATION=          # e.g. exec,browser,write — AI sends you approve/deny button

# =============================================================
# Web Search
# =============================================================
WEB_SEARCH_PROVIDER=brave            # brave | perplexity | gemini
BRAVE_API_KEY=                       # https://api.search.brave.com
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# =============================================================
# Shell / Exec  (DANGEROUS — off by default)
# =============================================================
EXEC_ENABLED=false
EXEC_TIMEOUT_SECONDS=30
EXEC_WORKING_DIR=~
EXEC_CONFIRMATION_TIMEOUT_SECONDS=120   # Seconds to wait for approve/deny

# =============================================================
# Browser / Playwright  (DANGEROUS — off by default)
# =============================================================
BROWSER_ENABLED=false
BROWSER_HEADLESS=true                # true = background, false = visible window

# =============================================================
# Memory
# =============================================================
MEMORY_ENABLED=true
MEMORY_DIR=~/.pygate/memory

# =============================================================
# Cron / Scheduling
# =============================================================
CRON_ENABLED=true
CRON_DB_PATH=~/.pygate/cron.db

# =============================================================
# Heartbeat (periodic agent wake — mirrors OpenClaw HEARTBEAT.md)
# Edit workspace/HEARTBEAT.md to define tasks the agent runs periodically.
# =============================================================
HEARTBEAT_ENABLED=false
HEARTBEAT_SCHEDULE=0 * * * *        # Cron expression: default = every hour

# =============================================================
# Text-to-Speech
# =============================================================
TTS_ENABLED=true
TTS_VOICE=en-US-GuyNeural           # Run: edge-tts --list-voices

# =============================================================
# General
# =============================================================
DATA_DIR=~/.pygate
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
MAX_HISTORY_MESSAGES=100             # Conversation turns kept per user
MAX_TOOL_ITERATIONS=10               # Max tool call loops per agent turn
