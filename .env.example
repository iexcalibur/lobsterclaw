# =============================================================
# LobsterClaw — Personal AI Assistant
# Copy this file to .env and fill in your values.
# Full documentation: workspace/TOOLS.md
# =============================================================

# =============================================================
# LLM Provider
# =============================================================
LLM_PROVIDER=anthropic               # anthropic | openai | gemini
ANTHROPIC_API_KEY=                   # Required if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                      # Required if LLM_PROVIDER=openai
GEMINI_API_KEY=                      # Required if LLM_PROVIDER=gemini
LLM_MODEL=claude-opus-4-5            # e.g. claude-opus-4-5, gpt-4o, gemini-2.5-flash
LLM_MAX_TOKENS=8096

# LLM Advanced
# LLM_THINKING_BUDGET=0                # Extended thinking token budget (Anthropic claude-3-7+; 0 = disabled)
# LLM_MAX_RETRIES=3                    # Max API retries on transient errors
# LLM_STREAMING=true                   # Stream text as editable preview messages (true = default)
# LLM_STREAM_MIN_EDIT_INTERVAL=3.0     # Minimum seconds between streaming preview edits
# LLM_SHOW_THINKING=false              # Show Anthropic extended thinking blocks in chat
# REASONING_MODE=auto                  # auto | on | off — controls reasoning format prompt section
#                                      # auto = detect from model name (deepseek-r1, o1, o3)

# Model aliases: short names → full model IDs (JSON dict)
# MODEL_ALIASES={"sonnet":"claude-sonnet-4-5","haiku":"claude-haiku-4-5","gpt4o":"gpt-4o"}

# =============================================================
# Telegram
# =============================================================
TELEGRAM_BOT_TOKEN=                  # From @BotFather
TELEGRAM_OWNER_ID=                   # Your numeric Telegram user ID (from @userinfobot)

# Multi-user & group access
# TELEGRAM_DM_POLICY=owner             # owner (default) | allowlist | pairing | open
# TELEGRAM_ALLOW_FROM=                 # Comma-separated user IDs allowed in DMs (allowlist mode)
# TELEGRAM_GROUP_POLICY=disabled       # disabled (default) | open | allowlist
# TELEGRAM_GROUP_ALLOWLIST=            # Comma-separated chat IDs for group allowlist

# Pairing mode (TELEGRAM_DM_POLICY=pairing):
# Unknown users requesting DM access get Approve/Deny buttons sent to the owner.
# Owner can also generate one-time codes with /pair code [ttl_minutes].
# Users can redeem with /pair <code> or deep link /start <code>.
# No extra config needed; pairing database is at ~/.lobsterclaw/pairing.db

# Mention gating (groups): only respond when @mentioned or replied to
# TELEGRAM_MENTION_REQUIRED=false
# TELEGRAM_REQUIRE_TOPIC=0             # If set, only respond in this forum thread_id

# Per-chat policy overrides (JSON: {"-100chatid": "open", "123": "disabled"})
# TELEGRAM_CHAT_POLICIES={}

# Callback auth: who can press agent inline buttons
# TELEGRAM_CALLBACK_POLICY=owner       # owner (default) | allowlist | open

# Multi-account (JSON array — overrides single-account env vars)
# TELEGRAM_ACCOUNTS=[{"label":"main","token":"...","owner_id":123},{"label":"group","token":"...","owner_id":123,"group_policy":"open"}]

# Voice transcription (Whisper via OpenAI API; requires OPENAI_API_KEY)
# TELEGRAM_VOICE_TRANSCRIPTION=false

# Link preview in outgoing messages
# TELEGRAM_LINK_PREVIEW=true

# Sticker vision: download .webp thumbnail and pass to LLM as image
# TELEGRAM_STICKER_VISION=false
# TELEGRAM_STICKER_CACHE_DB=~/.lobsterclaw/sticker_cache.db

# Reaction lifecycle emojis (sent to the inbound message)
# TELEGRAM_REACTIONS_ENABLED=true       # Set false to disable all automatic reactions
# TELEGRAM_REACTION_THINKING=👀
# TELEGRAM_REACTION_WORKING=⚙
# TELEGRAM_REACTION_DONE=✅
# TELEGRAM_REACTION_ERROR=❌
# TELEGRAM_REACTION_DONE_CLEAR_SECS=3.0  # Seconds before ✅ is removed (0 = keep)
# TELEGRAM_REACTION_FALLBACK=👍,🔥       # Fallback emojis on REACTION_INVALID

# Webhook mode (leave blank to use polling)
# TELEGRAM_WEBHOOK_URL=https://example.com/bot
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=

# Polling offset persistence (skip already-processed updates on restart)
# TELEGRAM_POLLING_OFFSET_PATH=~/.lobsterclaw/telegram_offset.json

# =============================================================
# Tool Policy
# Controls exactly which tools the AI can use.
# TOOLS_ALLOW  — whitelist (only these run; empty = allow all non-denied)
# TOOLS_DENY   — blacklist (always blocked regardless of allow list)
# TOOLS_REQUIRE_CONFIRMATION — AI asks you before running (Approve/Deny button)
#
# Full tool list:
#   Web:        web_fetch, web_search
#   Shell:      exec, process
#   Files:      read, write, edit, apply_patch, list_dir, glob, delete, move
#   Browser:    browser
#   Memory:     memory_search, memory_get, memory_write, memory_list, memory_delete
#   Media:      pdf, image, tts
#   Messaging:  message
#   Scheduling: cron
#   Gateway:    gateway
#   Gmail:      gmail_search, gmail_send, gmail_read, gmail_reply,
#               gmail_archive, gmail_label, gmail_mark_read, gmail_vip
#   Calendar:   calendar_list, calendar_create, calendar_rsvp
#   Sessions:   sessions_spawn, sessions_list, sessions_history, sessions_send,
#               session_status, subagents, agents_list
#   Plugins:    (any tool registered by workspace/plugins/ or ~/.lobsterclaw/plugins/)
# =============================================================
TOOLS_ALLOW=web_fetch,web_search,cron,memory_search,memory_get,memory_write,memory_list,memory_delete,message,tts,pdf,image,gmail_search,gmail_send,gmail_read,gmail_reply,gmail_archive,gmail_label,gmail_mark_read,gmail_vip,calendar_list,calendar_create,calendar_rsvp,sessions_spawn,sessions_list,sessions_history,sessions_send,session_status,subagents,agents_list,read
TOOLS_DENY=exec,process,browser,write,edit,apply_patch,delete,move,gateway
TOOLS_REQUIRE_CONFIRMATION=          # e.g. exec,browser,write

# =============================================================
# Web Search
# =============================================================
# Provider: ddg | brave | perplexity | gemini | grok | kimi
# ddg = DuckDuckGo (free, no API key required — good default)
# Fallback: LobsterClaw tries the next available provider if the primary fails
WEB_SEARCH_PROVIDER=ddg
BRAVE_API_KEY=                       # https://api.search.brave.com
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=                        # https://console.x.ai/ — uses grok-3 with web search
KIMI_API_KEY=                        # https://platform.moonshot.cn/ — moonshot-v1-auto
WEB_SEARCH_MAX_RESULTS=10

# Google Custom Search (alternative to Brave for web_search tool)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# =============================================================
# Shell / Exec  (DANGEROUS — disabled by default)
# =============================================================
EXEC_ENABLED=false
EXEC_ELEVATED_ENABLED=false          # Allow sudo/elevated commands
EXEC_TIMEOUT_SECONDS=30
EXEC_WORKING_DIR=~
EXEC_CONFIRMATION_TIMEOUT_SECONDS=120   # Seconds to wait for approve/deny

# =============================================================
# Browser / Playwright  (DANGEROUS — disabled by default)
# Install: playwright install chromium
# =============================================================
BROWSER_ENABLED=false
BROWSER_HEADLESS=true                # true = background, false = visible window

# =============================================================
# Google Workspace — Gmail + Calendar
# Requires OAuth 2.0 credentials from Google Cloud Console.
# Steps:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID (Web application)
#   3. Add authorized redirect URI:
#        http://localhost:4400/api/gateway/google-oauth/callback
#   4. Enable: Gmail API + Google Calendar API in the project
#   5. Fill in CLIENT_ID and CLIENT_SECRET below
#   6. Start LobsterClaw and connect your account in Gateway UI → Google Accounts
# =============================================================
GOOGLE_WORKSPACE_ACCOUNTS_FILE=~/.lobsterclaw/google_workspace/accounts.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional — defaults to the callback URL above
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4400/api/gateway/google-oauth/callback

# Gmail VIP watcher — sends a Telegram notification when a VIP sender emails you
# Comma-separated email addresses; seeds vip_senders.json on first run.
# You can also manage this list at runtime: "add boss@company.com to VIP list"
GMAIL_VIP_SENDERS=                   # e.g. boss@company.com,client@corp.com
GMAIL_WATCH_INTERVAL_MINUTES=30      # How often to poll for new VIP emails

# Calendar meeting reminder — Telegram notification sent before meetings start
CALENDAR_REMINDER_MINUTES=10         # Minutes before meeting to send reminder

# =============================================================
# AI News Research Agent
# Continuously searches the web for trending AI news and displays
# results in the Gateway UI → AI News dashboard.
# =============================================================
AI_NEWS_ENABLED=true                 # Set false to disable the background watcher
AI_NEWS_POLL_INTERVAL_MINUTES=60     # How often to search for new articles (default 1h)
AI_NEWS_RETENTION_DAYS=3             # How many days to keep articles before expiring

# =============================================================
# Memory
# Memory files stored in workspace/memory/*.md (human-readable + editable)
# =============================================================
MEMORY_ENABLED=true
MEMORY_DIR=                          # Leave blank to use workspace/memory/ (default)
MEMORY_SEMANTIC=false                # Enable OpenAI embedding-based semantic search
                                     # (requires OPENAI_API_KEY; uses text-embedding-3-small)
# MEMORY_EMBEDDING_PROVIDER=none     # none (default) | openai | gemini
# MEMORY_INDEX_PERSIST=true          # Keep SQLite index (faster incremental search)
# MEMORY_CITATIONS_MODE=off          # off (default) | inline | footnote — cite sources in replies

# Memory flush: write memories to disk before context compaction
# MEMORY_FLUSH_ENABLED=true
# MEMORY_FLUSH_SOFT_TOKENS=4000      # Token headroom before flush triggers

# Nightly memory consolidation — distils today's daily log into MEMORY.md
# NIGHTLY_MEMORY_ENABLED=true
# NIGHTLY_MEMORY_SCHEDULE=30 23 * * *   # Cron expression (default: 11:30 PM daily)

# =============================================================
# Cron / Scheduling
# =============================================================
CRON_ENABLED=true
CRON_DB_PATH=~/.lobsterclaw/cron.db

# =============================================================
# Heartbeat (periodic agent wake — mirrors OpenClaw HEARTBEAT.md)
# Edit workspace/HEARTBEAT.md to define tasks the agent runs periodically.
# Heartbeat can run without CRON_ENABLED=true (uses its own scheduler).
# =============================================================
HEARTBEAT_ENABLED=false
HEARTBEAT_SCHEDULE=0 * * * *        # Cron expression: default = every hour
# HEARTBEAT_ACTIVE_HOURS_START=0    # Only fire heartbeat/cron in this hour range (0-23 local)
# HEARTBEAT_ACTIVE_HOURS_END=23     # Set e.g. 8 / 22 to suppress overnight wakes

# =============================================================
# Sub-agents (sessions_spawn)
# Agents can delegate tasks to isolated sub-agents in the background.
# =============================================================
SUBAGENTS_ENABLED=true
SUBAGENTS_MAX_DEPTH=3               # Max nesting: main → child → grandchild
SUBAGENTS_MAX_CHILDREN=5            # Max concurrent sub-agents per session

# =============================================================
# Safety Limits
# =============================================================
TOOL_RESULT_MAX_CHARS=50000         # Hard cap on per-tool output size (context overflow guard)

# =============================================================
# Text-to-Speech
# List voices: edge-tts --list-voices
# =============================================================
TTS_ENABLED=true
TTS_VOICE=en-US-GuyNeural
# TTS_HINT_IN_PROMPT=true           # Show TTS hint in system prompt

# =============================================================
# Canvas Host (FastAPI + WebSocket server for interactive UIs)
# Start the Next.js frontend separately: cd canvas_frontend && npm run dev
# =============================================================
# CANVAS_HOST_ENABLED=false
# CANVAS_HOST_PORT=7681
# CANVAS_HOST_BIND=127.0.0.1
# CANVAS_TELEGRAM_RENDER=true        # Send canvas snapshots as Telegram photos
# CANVAS_FRONTEND_DEV=false          # true = proxy to Next.js dev server
# CANVAS_FRONTEND_DEV_PORT=3000
# CANVAS_EVENT_TIMEOUT=60            # Seconds to wait for user interaction

# =============================================================
# Gateway UI (Mission Control dashboard)
# Provides a web-based dashboard at http://localhost:4400
# The Next.js frontend runs separately at http://localhost:3001
# =============================================================
GATEWAY_ENABLED=true
GATEWAY_PORT=4400
GATEWAY_BIND=127.0.0.1
GATEWAY_API_KEY=                     # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_CORS_ORIGINS=                # Comma-separated, e.g. http://localhost:3001

# =============================================================
# Discord
# Requires: pip install "discord.py>=2.3.0"
# =============================================================
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=                   # From Discord Developer Portal
DISCORD_GUILD_ID=                    # Optional: restrict to one server
DISCORD_CHANNEL_ID=                  # Optional: default channel for send_message()
DISCORD_OWNER_ID=                    # Your Discord user ID
DISCORD_DM_POLICY=owner              # owner | open
DISCORD_MENTION_REQUIRED=true        # Only respond when @mentioned in guilds
DISCORD_STREAMING=true               # Live preview while agent thinks

# =============================================================
# Plugins (workspace/plugins/ and ~/.lobsterclaw/plugins/)
# Requires: pip install "watchdog>=3.0.0" for hot-reload
# =============================================================
PLUGIN_HOT_RELOAD=true

# =============================================================
# Security
# =============================================================
PROMPT_INJECTION_FENCE=true          # Wrap external tool results in XML fences (default: true)
SSRF_ALLOW_HOSTS=                    # Comma-separated trusted hosts exempt from SSRF block
GATEWAY_ENCRYPT_SECRETS=false        # Encrypt API keys at rest (requires cryptography>=41.0.0)
# TRANSCRIPT_REPAIR_ENABLED=true     # Strip orphaned tool_use/tool_result blocks before LLM calls
# HOOKS_ENABLED=true                 # Enable pre/post tool hook callbacks (workspace/hooks/)

# =============================================================
# Agent Identity & Behaviour
# =============================================================
# AGENT_ID=                          # Human-readable agent name shown in the Runtime prompt line
# PROMPT_MODE=full                   # full (default) | minimal (sub-agents) | none
# OWNER_DISPLAY_NAME=                # Your name shown in Authorized Senders section (e.g. "Peter")
# USER_TIMEZONE=                     # e.g. America/New_York — shown in prompt; empty = system TZ
# SHELL_NAME=                        # e.g. zsh, bash — shown in Runtime line; empty = auto-detect

# Silent reply token — agent outputs this when it has nothing to say (Telegram suppresses it)
# SILENT_REPLY_TOKEN=NO_REPLY
# Heartbeat acknowledgement token — agent outputs this for no-op heartbeat polls
# HEARTBEAT_OK_TOKEN=HEARTBEAT_OK

# Reaction guidance in the prompt: off (default) | minimal | extensive
# REACTION_GUIDANCE_LEVEL=off

# =============================================================
# General
# =============================================================
LIGHT_CONTEXT=false                  # Set true or use --light-context for fast cron/heartbeat runs
DATA_DIR=~/.lobsterclaw
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
MAX_HISTORY_MESSAGES=100             # Conversation turns kept per user (persisted to SQLite)
MAX_TOOL_ITERATIONS=10               # Max tool call loops per agent turn
